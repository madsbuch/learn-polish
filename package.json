{
  "name": "learn-polish",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-design.mjs && eslint . && tsc --noEmit && vite build",
    "lint": "eslint .",
    "check:rust": "cd src-tauri && cargo clippy --locked --all-targets",
    "check:design": "node scripts/check-design.mjs",
    "check:shapes": "cd src-tauri && cargo test --locked shapes_for_the_screens && cd .. && bun scripts/check-shapes.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "android:init": "tauri android init --ci && node scripts/prepare-android.mjs",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:dev": "node scripts/prepare-android.mjs && tauri android dev",
    "android:build": "node scripts/prepare-android.mjs && tauri android build --apk --ci --target aarch64 --target armv7",
    "app:dev:tablet": "tauri dev --config src-tauri/tauri.tablet.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-barcode-scanner": "~2.4.6",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "jsqr": "1.4.0",
    "katex": "0.16.22",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.44.0",
    "vite": "^7.1.0"
  }
}
